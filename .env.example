# Firebase Web SDK（Auth + Firestore + Storage）— 僅占位，勿提交真實值。
# 複製為本機 `.env`；負責人拍板 Firebase 專案後，將下列 YOUR_* 全部替換為 Console 提供的 Web app 設定。
# 本 repo 不建立 Firebase 專案；Phase 1 後台前端亦勿依賴已登入才能閱讀本檔。

FIREBASE_API_KEY=YOUR_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_WEB_APP_ID

# 選用：App Check（正式環境建議）
# FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY

# 選用：租戶／品牌 id（單店 MVP 可沿用預設）
# TEATOP_TENANT_ID=YOUR_BRAND_ID

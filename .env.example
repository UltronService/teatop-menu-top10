# Firebase Web SDK (client) — copy to `.env` locally; never commit real values.
# Used by future `/admin` SPA build (Vite/React or similar). GitHub Pages players stay on static `data/*.json` until wired.

FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:00000000000000000000

# Optional: App Check (recommended before production admin)
# FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# Optional: default tenant / brand id for multi-store (single-tenant MVP can leave default)
# TEATOP_TENANT_ID=teatop-default
